# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.
ANTHROPIC_API_KEY=
LLM_PROVIDER=fake
# Solo si LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Clasificador de intención (opcional; por defecto apagado)
USAR_CLASIFICADOR_LLM=false
# Orquestador: máximo de llamadas al LLM por turno (>= 1; por defecto 5)
MAX_ITERACIONES_LLM=5

# Carpeta de logs del CLI (opcional; por defecto logs/ en la raíz del repo)
# TIENDAHOGAR_LOGS_DIR=
